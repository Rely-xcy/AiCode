<?xml version="1.0" encoding="utf-8"?>
<!-- AiCove 启动图标前景：静湾与原点（The Quiet Cove）。
     深陶炭 #2E2823，纯色无渐变；图形落在自适应图标中心安全区内。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 图形按 512 标准图标的 60% 占比反算：adaptive icon 系统会把 108dp 画布放大
         再裁到 72dp 安全区。实测 MIUI 上 0.842 仍占 60-70%，留白偏少，故收到 0.68，
         目标显示占 52% 左右，与设计预览一致。 -->
    <group
        android:scaleX="0.68"
        android:scaleY="0.68"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:fillColor="#2E2823"
            android:pathData="M54,26.5 A27.5,27.5 0 1 0 77.8,67.7 A5.05,5.05 0 0 0 70.8,60.4 A17.4,17.4 0 1 1 54,36.6 A5.05,5.05 0 0 0 54,26.5 Z" />
        <path
            android:fillColor="#2E2823"
            android:pathData="M44.85,54 A9.15,9.15 0 1 0 63.15,54 A9.15,9.15 0 1 0 44.85,54 Z" />
    </group>
</vector>
