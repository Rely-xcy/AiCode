<?xml version="1.0" encoding="utf-8"?>
<!-- 前景：海湾弧 + 圆核（512 标准图标里图形占 60%，线条厚度约 12%）。
     adaptive icon 系统会把 108dp 画布放大再裁到 72dp 安全区，MIUI 实测放大倍率
     约 1.6-1.75，故 group 收到 0.68，使桌面显示占约 52%。
     弧与圆核都改用 stroke/fill 分开描述：线条粗细由 strokeWidth 直接控制，
     比 fill 双弧更容易按真机反馈微调。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.68"
        android:scaleY="0.68"
        android:pivotX="54"
        android:pivotY="54">
        <!-- 海湾弧：半径 24.25，线宽 6.5（外径 55，厚约 11.8%） -->
        <path
            android:pathData="M 54,29.75 A 24.25,24.25 0 1 0 75.0,66.1"
            android:strokeColor="#2E2823"
            android:strokeWidth="6.5"
            android:strokeLineCap="round" />
        <!-- 圆核 -->
        <path
            android:pathData="M 54,45.5 A 8.5,8.5 0 1 1 54,62.5 A 8.5,8.5 0 1 1 54,45.5"
            android:fillColor="#2E2823" />
    </group>
</vector>
